{
  "name": "@tak1208/dsh-webui-transition",
  "version": "0.2.1",
  "description": "DSH Web GUI 扩展：为设置面板与各级下拉菜单补上开合过渡动画（Client-only bundle，源码 ESM + esbuild 构建，零第三方运行时依赖）。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "webui",
    "transition",
    "animation"
  ],
  "homepage": "https://github.com/T-MKT/dsh-webui-transition#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-MKT/dsh-webui-transition.git"
  },
  "bugs": {
    "url": "https://github.com/T-MKT/dsh-webui-transition/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "author": "tak1208",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "node --test",
    "prepublishOnly": "pnpm test"
  }
}
